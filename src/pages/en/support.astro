---
import Base from '../../layouts/base.astro';
import { brand, site } from '../../lib/site';

const open = Object.entries(site.support).filter(([, v]) => v);
---

<Base
  title="Support"
  description="Ways to support this record, and how to work with me."
  path="/en/support"
  lang="en"
  switchHref="/support">
  <section class="wrap measure flow">
    <h1>Support and work</h1>
    <div class="prose">
      <p>
        This site sells nothing, carries no ads, and takes no sponsored posts. Its only return is that people can check
        what I have been doing over time. If you want it to keep going, talk to me about work — or use one of the options below.
      </p>

      {
        open.length === 0 ? (
          <div class="card-flat">
            <p class="meta">
              Support links (Co-fi / Buy Me a Coffee style) are not live yet. When they are, they will appear here; for now
              just <a href={`mailto:${site.anchors.email}`}>email me</a>.
            </p>
          </div>
        ) : (
          <ul>
            {open.map(([k, v]) => (
              <li>
                <a href={v} rel="noopener">{k}</a>
              </li>
            ))}
          </ul>
        )
      }

      <h2>Working together</h2>
      <ul>
        <li>Engineering / advisory: start with the <a href="/en/journal">journal</a> — judgement shows better than a CV.</li>
        <li>Product and growth: read the <a href="/en/essays">essays</a> and <a href="/en/projects">projects</a>.</li>
        <li>Email {site.anchors.email}, subject "work · your company · what you want".</li>
      </ul>

      <p class="meta">{brand.name} · {site.author} · {brand.slogan}</p>
    </div>
  </section>
</Base>
