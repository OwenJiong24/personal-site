---
import Post from '../../../layouts/post.astro';
import { publishedIn, keyOf, type Zone } from '../../../lib/trust';
import { render } from 'astro:content';
export async function getStaticPaths() {
  const out: Array<{ params: { zone: string; slug: string }; props: Record<string, unknown> }> = [];
  for (const zone of ['journal', 'insights', 'work'] as Zone[]) {
    const siblings = await publishedIn(zone, 'en');
    for (const entry of siblings) {
      out.push({ params: { zone, slug: keyOf(entry) }, props: { entry, zone, siblings } });
    }
  }
  return out;
}
const { entry, zone, siblings } = Astro.props;
const { Content } = await render(entry);
---
<Post entry={entry} zone={zone} lang="en" siblings={siblings}>
  <Content />
</Post>
