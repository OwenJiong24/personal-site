---
import Post from '../../layouts/post.astro';
import { publishedIn, keyOf } from '../../lib/trust';
import { sections } from '../../lib/site';
import { render } from 'astro:content';
export async function getStaticPaths() {
  const out: Array<{ params: { zone: string; slug: string }; props: Record<string, unknown> }> = [];
  for (const zone of sections) {
    const siblings = await publishedIn(zone, 'zh');
    for (const entry of siblings) {
      out.push({ params: { zone, slug: keyOf(entry) }, props: { entry, zone, siblings } });
    }
  }
  return out;
}
const { entry, zone, siblings } = Astro.props;
const { Content } = await render(entry);
---
<Post entry={entry} zone={zone} lang="zh" siblings={siblings}>
  <Content />
</Post>
