---
import Post from '../../layouts/post.astro';
import { zones } from '../../lib/site';
import { publishedIn } from '../../lib/trust';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const out: Array<{ params: { zone: string; slug: string }; props: Record<string, unknown> }> = [];
  for (const z of zones) {
    const posts = await publishedIn(z.slug);
    for (const p of posts) {
      out.push({ params: { zone: z.slug, slug: p.id }, props: { entry: p, zone: z, siblings: posts } });
    }
  }
  return out;
}

const { entry, zone, siblings } = Astro.props;
const { Content } = await render(entry);
---

<Post entry={entry} zone={zone.slug} zoneName={zone.name} siblings={siblings}>
  <Content />
</Post>
