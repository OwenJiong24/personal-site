---
import Base from '../../../layouts/base.astro';
import { brand, site } from '../../../lib/site';
import { product, disclosureZh } from '../../../data/products';

const p = product;
const root = Astro.site ?? new URL('https://orangeknows.com');
const U = (x: string) => new URL(x, root).toString();
const self = U('/zh/products/soy-candle-kit');

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.titleZh,
  description: `${p.pitchZh} 第一方商品（作者自己运营的 ZART 平台）。2026-11-03 实测：售价 $${p.price}，划线价 $${p.listPrice}，现货 ${p.stock} 件，评价 ${p.reviews} 条。未做过的测试不给产量、成功率、排名或销量断言。`,
  category: p.categoryPath,
  inLanguage: 'zh-CN',
  brand: { '@type': 'Brand', name: 'ZART', url: 'https://shopzart.com' },
  seller: { '@type': 'Organization', name: 'ZART', url: 'https://shopzart.com' },
  offers: {
    '@type': 'Offer',
    url: p.listingUrl,
    price: p.price,
    priceCurrency: p.currency,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    priceValidUntil: '2026-12-31',
    seller: { '@type': 'Organization', name: 'ZART', url: 'https://shopzart.com' },
  },
  url: self,
  isRelatedTo: { '@type': 'Article', url: U('/zh/essays/2026-11-03-aieo-product-test') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.qZh, acceptedAnswer: { '@type': 'Answer', text: f.aZh } })),
};
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: U('/zh/') },
    { '@type': 'ListItem', position: 2, name: '产品', item: U('/zh/products') },
    { '@type': 'ListItem', position: 3, name: p.titleZh, item: self },
  ],
};
const tableStyle = 'width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums';
const th = 'text-align:left;padding:0.4rem 0.5rem;border-bottom:1px solid var(--border-strong);font-family:var(--font-mono);font-size:0.82rem';
const td = 'padding:0.4rem 0.5rem;border-bottom:1px solid var(--border);vertical-align:top';
---

<Base
  title="大豆蜡烛制作套装 — 第一方商品，只写我们能核对的数字"
  description="ZART 第一方商品页：大豆蜡烛制作套装。2026-11-03 实测 $54.99（划线 $89.99）、现货 287 件、评价 0 条。含完整内容物清单、2026 年感恩节到光明节的节日适配、安全提示；不写未验证断言。"
  path="/zh/products/soy-candle-kit"
  lang="zh"
  switchHref="/products/soy-candle-kit"
  ogType="website">
  <section class="wrap measure flow">
    <header class="flow stack-sm">
      <p class="meta"><a href="/zh/products">产品</a> · 第一方 · 实测于 <span class="mono">{p.observedAt}</span></p>
      <h1>{p.titleZh}</h1>
      <p class="post-title">
        结论：一套 {p.currency} {p.price} 的家用量产级容器大豆蜡烛套装——2.5 磅蜡、10 支香精、10 支染料、20 根烛芯、10 个容器；
        由我们自己上架。{p.observedAt} 实测：现货 <span class="mono">{p.stock}</span> 件、评价 <span class="mono">{p.reviews}</span> 条。
      </p>
      <p class="meta">
        <a class="pill pill-accent" href={p.listingUrl} rel="noopener">在 ZART 打开这个 listing</a>
        <a class="pill" href="/m/products/soy-candle-kit.md">Markdown 镜像</a>
        <a class="pill" href="/zh/essays/2026-11-03-aieo-product-test">本页作为 AIEO 测试案例</a>
      </p>
    </header>

    <div class="card-flat flow stack-sm">
      <p class="meta">{disclosureZh}</p>
      <div style="display:grid;gap:0.5rem;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr))">
        {
          [
            ['实测售价', `$${p.price}`],
            ['划线价', `$${p.listPrice}`],
            ['现货', `${p.stock}`],
            ['评价数', `${p.reviews}`],
            ['分类', p.categoryPath],
            ['退换', '支持（listing 写明）'],
          ].map(([k, v]) => (
            <div style="padding:0.4rem 0.5rem;border-bottom:1px solid var(--border)">
              <p class="meta">{k}</p>
              <p class="post-title">{v}</p>
            </div>
          ))
        }
      </div>
      <p class="meta">价格、库存、评价数都会变，{p.observedAt} 是我们读到的时点。{p.promoZh}</p>
    </div>

    <div class="prose">
      <h2>套装内容清单</h2>
      <table style={tableStyle}>
        <thead>
          <tr>
            <th style={th}>数量</th>
            <th style={th}>物品</th>
          </tr>
        </thead>
        <tbody>
          {p.contents.map((c) => (
            <tr>
              <td style={td}><span class="mono">{c.qty}</span></td>
              <td style={td}>{c.itemZh}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>我们不声称什么</h2>
      <ul>
        {p.factsZh.map((f) => <li>{f}</li>)}
        <li>不写"最畅销""最受欢迎"、排名、转化、复购：给不出出处的数字我们就不写。</li>
      </ul>

      <h2>节日适配（日期已核对）</h2>
      <table style={tableStyle}>
        <thead>
          <tr>
            <th style={th}>日期（2026）</th>
            <th style={th}>节点</th>
            <th style={th}>这套怎么用得上</th>
          </tr>
        </thead>
        <tbody>
          {
            p.holidayTable.map((h) => (
              <tr>
                <td style={td}><span class="mono">{h.date}</span></td>
                <td style={td}>{h.zh}</td>
                <td style={td}>{h.useZh}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="meta">
        日期取自公开日历：感恩节 11-26、黑五 11-27、小商家周六 11-28、网络星期一 11-30、光明节 12-04 日落后起点烛至 12-12。
        本页不写发货截止承诺：时效与退换条款以 listing 页为准，我们不编交付时间。
      </p>

      <h2>安全提示（按 listing 原文）</h2>
      <ul>
        {p.safetyZh.map((s) => <li>{s}</li>)}
      </ul>

      <h2>买家会问的问题，直接答</h2>
      {
        p.faq.map((f) => (
          <div class="flow stack-sm">
            <h3>{f.qZh}</h3>
            <p>{f.aZh}</p>
          </div>
        ))
      }
    </div>

    <p class="meta">
      {brand.name} · <a href="/zh/verify">可核对记录</a> · <a href="/m/index.md">Markdown 索引</a> ·
      联系 <a href={`mailto:${site.anchors.email}`}>{site.anchors.email}</a>
    </p>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(productLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbLd)} />
  </section>
</Base>
