---
import Base from '../layouts/base.astro';
import { brand, site } from '../lib/site';
import { publishedPosts, utcDay } from '../lib/trust';

const posts = await publishedPosts('en');
const updated = '2026-10-30';
---

<Base
  title="Now"
  description={`What I am doing right now. Updated ${updated} (UTC).`}
  path="/now"
  lang="en"
  switchHref="/zh/now">
  <section class="wrap measure flow">
    <header class="flow stack-sm">
      <h1>Now</h1>
      <p class="meta">Updated {updated} (UTC) · this page only holds the present; history lives in the <a href="/en/timeline">timeline</a></p>
    </header>

    <div class="prose">
      <h2>Working on</h2>
      <ul>
        <li>{brand.name} itself — treated as a product: content pipeline, publish gate, record chain.</li>
        <li>The e-commerce system I run, as far as it can be public (see <a href="/en/projects">Projects</a>).</li>
        <li>Turning my own development sessions into dated journal entries — one per day.</li>
      </ul>

      <h2>Thinking about</h2>
      <ul>
        <li>How a person stays verifiable in the model era: chained records, GitHub commits, one handle and one email.</li>
        <li>Publishing granularity: deep enough to be evidence, shallow enough to not leak what is unreleased.</li>
      </ul>

      <h2>Paused</h2>
      <ul>
        <li>Daily social posting. Effort goes into code and this record.</li>
      </ul>

      <p class="meta">
        Latest entry: {posts[0] ? `${posts[0].data.title} (${utcDay(posts[0].data.date)})` : 'none yet'}
      </p>
      <p class="meta">Contact: {site.anchors.email}</p>
    </div>
  </section>
</Base>
