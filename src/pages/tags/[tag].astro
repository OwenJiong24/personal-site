---
import Base from '../../layouts/base.astro';
import { linkableTags, postsByTag, tagStats, tagPageExists } from '../../lib/tags';
import { keyOf, utcDay, type Post } from '../../lib/trust';
import { brand } from '../../lib/site';

export async function getStaticPaths() {
  const tags = await linkableTags('en');
  return tags.map((t) => ({ params: { tag: t.slug }, props: { tag: t.tag } }));
}

const { tag } = Astro.props as { tag: string };
const lang = 'en';
const posts = (await postsByTag(tag, lang)) as Post[];
const all = await tagStats();
const entry = all.find((t) => t.tag === tag);
const slug = entry?.slug ?? '';
// 语言切换只在另一语言的标签页真的存在时给（单语标签的英文页不能指向不存在的 /zh/tags/…）
const switchHref = entry && tagPageExists(entry, 'zh') ? `/zh/tags/${slug}` : undefined;
const listStyle = 'list-style:none;padding:0;margin:0;display:grid;gap:0.75rem';
---

<Base
  title={`Tag · ${tag}`}
  description={`${posts.length} English entries tagged “${tag}” in the ${brand.name} public record.`}
  path={`/tags/${slug}`}
  lang={lang}
  switchHref={switchHref}>
  <section class="wrap measure flow">
    <header class="flow stack-sm">
      <p class="meta"><a href="/tags">All tags</a></p>
      <h1>{tag}</h1>
      <p class="meta">{posts.length} English entries with this tag (the tag also appears on Chinese entries).</p>
    </header>

    <ul style={listStyle}>
      {
        posts.map((p) => (
          <li>
            <a href={`/${p.collection}/${keyOf(p)}`}>
              <span class="meta">{utcDay(p.data.date)} · {p.collection}</span>
              <p class="post-title">{p.data.title}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `Tag: ${tag}`,
      url: new URL(`/tags/${entry?.slug ?? ''}`, Astro.site ?? 'https://orangeknows.com').toString(),
      inLanguage: 'en',
      numberOfItems: posts.length,
      isPartOf: { '@type': 'WebSite', url: (Astro.site ?? 'https://orangeknows.com').toString() },
    })} />
  </section>
</Base>
