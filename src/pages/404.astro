import Base from '../layouts/base.astro';

<Base title="404 · Nothing here / 这里没有东西" description="This address has no content. 这个地址没有内容。" path="/404" noindex>
  <section class="wrap measure flow">
    <h1>404 · Nothing here</h1>
    <p style="color: var(--text-2)">
      The address may be a typo, or the entry was renamed. Every record is in the
      <a href="/timeline">timeline</a>.
    </p>
    <p style="color: var(--text-2)" lang="zh">地址可能写错了，或这条被改名。全部记录见时间线。</p>
    <p style="display: flex; gap: 0.625rem; flex-wrap: wrap">
      <a class="btn" href="/">Home / 回首页</a>
      <a class="btn btn-ghost" href="/timeline">Timeline / 时间线</a>
      <a class="btn btn-ghost" href="/zh/">中文站</a>
    </p>
  </section>
</Base>
