---
import Base from '../../layouts/base.astro';
import { brand, site } from '../../lib/site';
import { product, disclosureEn } from '../../data/products';

const p = product;
const root = Astro.site ?? new URL('https://orangeknows.com');
const U = (x: string) => new URL(x, root).toString();
const self = U('/products/soy-candle-kit');

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.titleEn,
  description:
    `${p.pitchEn} First-party product on ZART (the marketplace this record's author runs). Observed 2026-11-03: price $${p.price}, list price $${p.listPrice}, ${p.stock} units in stock, ${p.reviews} reviews. No yield, success-rate, ranking or sales claim is made because we have not tested them.`,
  category: p.categoryPath,
  brand: { '@type': 'Brand', name: 'ZART', url: 'https://shopzart.com' },
  seller: { '@type': 'Organization', name: 'ZART', url: 'https://shopzart.com' },
  offers: {
    '@type': 'Offer',
    url: p.listingUrl,
    price: p.price,
    priceCurrency: p.currency,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    priceValidUntil: '2026-12-31',
    seller: { '@type': 'Organization', name: 'ZART', url: 'https://shopzart.com' },
  },
  url: self,
  isRelatedTo: { '@type': 'Article', url: U('/essays/2026-11-03-aieo-product-test') },
  subjectOf: { '@type': 'WebPage', url: self },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.qEn, acceptedAnswer: { '@type': 'Answer', text: f.aEn } })),
};
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: U('/') },
    { '@type': 'ListItem', position: 2, name: 'Products', item: U('/products') },
    { '@type': 'ListItem', position: 3, name: p.titleEn, item: self },
  ],
};
const tableStyle = 'width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums';
const th = 'text-align:left;padding:0.4rem 0.5rem;border-bottom:1px solid var(--border-strong);font-family:var(--font-mono);font-size:0.82rem;text-transform:uppercase;letter-spacing:0.06em';
const td = 'padding:0.4rem 0.5rem;border-bottom:1px solid var(--border);vertical-align:top';
---

<Base
  title="Soy Candle Making Kit — first-party product, with the numbers we can check"
  description="First-party ZART product page: soy candle making kit, observed 2026-11-03 at $54.99 (list $89.99), 287 in stock, 0 reviews. Full contents, holiday fit for Thanksgiving through Hanukkah 2026, safety notes, and no unverified claims."
  path="/products/soy-candle-kit"
  lang="en"
  switchHref="/zh/products/soy-candle-kit"
  ogType="website">
  <section class="wrap measure flow">
    <header class="flow stack-sm">
      <p class="meta"><a href="/products">Products</a> · first-party · observed <span class="mono">{p.observedAt}</span></p>
      <h1>{p.titleEn}</h1>
      <p class="post-title">
        Bottom line: a {p.currency} {p.price} all-in-one kit for making sale-ready container soy candles at home —
        2.5 lb wax, 10 fragrance oils, 10 dyes, 20 wicks and 10 vessels — listed by us on our own marketplace at
        <span class="mono">{p.stock}</span> units in stock and <span class="mono">{p.reviews}</span> reviews as observed
        {p.observedAt}.
      </p>
      <p class="meta">
        <a class="pill pill-accent" href={p.listingUrl} rel="noopener">Open the listing on ZART</a>
        <a class="pill" href="/m/products/soy-candle-kit.md">Markdown mirror</a>
        <a class="pill" href="/essays/2026-11-03-aieo-product-test">This page as an AIEO test case</a>
      </p>
    </header>

    <div class="card-flat flow stack-sm">
      <p class="meta">{disclosureEn}</p>
      <div style={tableStyle} role="table">
        <div role="row" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr))">
          {
            [
              ['Price observed', `$${p.price}`],
              ['List price', `$${p.listPrice}`],
              ['In stock', `${p.stock}`],
              ['Reviews', `${p.reviews}`],
              ['Category', p.categoryPath],
              ['Returns', 'Eligible (stated on listing)'],
            ].map(([k, v]) => (
              <div style="padding:0.4rem 0.5rem;border-bottom:1px solid var(--border)">
                <p class="meta">{k}</p>
                <p class="post-title">{v}</p>
              </div>
            ))
          }
        </div>
      </div>
      <p class="meta">
        Price, stock and review count change; {p.observedAt} is when we read them. {p.promoEn}
      </p>
    </div>

    <div class="prose">
      <h2>What is in the kit</h2>
      <table style={tableStyle}>
        <thead>
          <tr>
            <th style={th}>Qty</th>
            <th style={th}>Item</th>
          </tr>
        </thead>
        <tbody>
          {p.contents.map((c) => (
            <tr>
              <td style={td}><span class="mono">{c.qty}</span></td>
              <td style={td}>{c.itemEn}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>What we do not claim</h2>
      <ul>
        {p.factsEn.map((f) => <li>{f}</li>)}
        <li>No "best-selling", "most gifted", ranking, conversion or repeat-purchase claim: we publish no number we cannot point to.</li>
      </ul>

      <h2>Holiday fit, with dates we checked</h2>
      <table style={tableStyle}>
        <thead>
          <tr>
            <th style={th}>Date (2026)</th>
            <th style={th}>Occasion</th>
            <th style={th}>Why this kit fits</th>
          </tr>
        </thead>
        <tbody>
          {
            p.holidayTable.map((h) => (
              <tr>
                <td style={td}><span class="mono">{h.date}</span></td>
                <td style={td}>{h.en}</td>
                <td style={td}>{h.useEn}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="meta">
        Dates cross-checked against published calendars: Thanksgiving 26 Nov, Black Friday 27 Nov, Small Business Saturday
        28 Nov, Cyber Monday 30 Nov, Hanukkah from sundown 4 Dec to 12 Dec. Shipping cut-offs are not published here:
        the listing shows the shipping and return terms, and we will not invent delivery promises.
      </p>

      <h2>Safety, as the listing states it</h2>
      <ul>
        {p.safetyEn.map((s) => <li>{s}</li>)}
      </ul>

      <h2>Questions a buyer asks, answered directly</h2>
      {
        p.faq.map((f) => (
          <div class="flow stack-sm">
            <h3>{f.qEn}</h3>
            <p>{f.aEn}</p>
          </div>
        ))
      }
    </div>

    <p class="meta">
      {brand.name} · <a href="/verify">checkable record</a> · <a href="/m/index.md">Markdown index</a> ·
      contact <a href={`mailto:${site.anchors.email}`}>{site.anchors.email}</a>
    </p>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(productLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbLd)} />
  </section>
</Base>
