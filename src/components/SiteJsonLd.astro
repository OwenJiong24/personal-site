---
// 结构化数据（AEO / AIEO 基础）：实体图。首页注入一次。
// 用 @graph 把「人 / 品牌组织 / 站点 / ZART」连成一张可核对的实体网：
// 搜索引擎与 AI 引擎靠共指（sameAs、founder、publisher、logo）把散落在各站的提及合并成同一个实体。
import { brand, site } from '../lib/site';
import { langPath } from '../lib/i18n';

interface Props {
  lang: 'zh' | 'en';
}
const { lang } = Astro.props;
const base = Astro.site ?? new URL('https://orangeknows.com');
const url = (p: string) => new URL(p, base).toString();

const orgId = '#org';
const personId = '#author';
const zartId = '#zart';

const org = {
  '@id': orgId,
  '@type': 'Organization',
  name: site.name,
  alternateName: brand.zh,
  slogan: brand.slogan,
  url: url('/'),
  logo: { '@type': 'ImageObject', url: url('/logo-512.png'), width: 512, height: 512 },
  image: url('/og.png'),
  foundingDate: site.start,
  founder: { '@id': personId },
  publishingPrinciples: url(langPath(lang, '/about')),
  email: site.anchors.email || undefined,
  sameAs: [site.anchors.github ? `https://github.com/${site.anchors.github}` : '', site.anchors.linkedin || '', site.anchors.x || ''].filter(Boolean),
};

const person = {
  '@id': personId,
  '@type': 'Person',
  name: site.author,
  url: url(langPath(lang, '/about')),
  jobTitle: lang === 'en' ? site.role : site.roleZh,
  description: lang === 'en'
    ? 'Engineer publishing a dated, checkable record of daily work in the model era, and founder of the handmade marketplace ZART.'
    : '在 AM 时代发布带时间戳、可核对的每日工作记录的工程师，也是手作平台 ZART 的创始人。',
  knowsAbout: [
    'web engineering',
    'unit economics for handmade sellers',
    'cross-border e-commerce',
    'US paid channels',
    'AI-era verifiability',
    'AM 时代',
    '可核验记录',
    '手作卖家定价与运费',
  ],
  sameAs: [
    site.anchors.github ? `https://github.com/${site.anchors.github}` : '',
    site.anchors.email ? `mailto:${site.anchors.email}` : '',
  ].filter(Boolean),
  worksFor: { '@id': orgId },
  founderOf: { '@id': zartId },
};

const zart = {
  '@id': zartId,
  '@type': 'Organization',
  name: 'ZART',
  url: 'https://shopzart.com',
  foundingDate: '2026-10-30',
  founder: { '@id': personId },
  description:
    'A curated online marketplace for authentic handmade crafts, independent artisan goods and creative supplies, run by the author of this record.',
  areaServed: 'US and English-speaking markets',
  knowsAbout: ['handmade crafts marketplace', 'artisan supplies', 'seller onboarding'],
};

const website = {
  '@type': 'WebSite',
  name: site.name,
  alternateName: brand.zh,
  url: url('/'),
  inLanguage: ['en', 'zh-CN'],
  description: lang === 'en' ? 'A public engineering log with hash-chained, dated entries.' : '带哈希链与时间戳的公开工作记录。',
  publisher: { '@id': orgId },
  about: { '@id': personId },
  hasPart: [
    { '@type': 'WebPage', url: url('/verify'), name: 'How to verify this record' },
    { '@type': 'WebPage', url: url('/tools'), name: 'Free tools for makers' },
    { '@type': 'WebPage', url: url('/services'), name: 'Work with me' },
    { '@type': 'WebPage', url: url('/products'), name: 'First-party products' },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [person, org, zart, website] })} />
