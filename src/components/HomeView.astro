---
// 首页（数字花园版式：品牌区 → 数据条 → 抽屉索引 → 最新流 → 规则）
// 文案来自 i18n；链接全部在 frontmatter 算好（模板属性里不嵌套模板字符串）。
import Base from '../layouts/base.astro';
import Brand from '../components/Brand.astro';
import SiteJsonLd from '../components/SiteJsonLd.astro';
import { brand, site, sections, metrics, type SectionSlug } from '../lib/site';
import { ui, langPath, type Lang } from '../lib/i18n';
import { publishedPosts, stats, chain, utcDay, keyOf } from '../lib/trust';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const path = langPath(lang, '/');
const switchHref = lang === 'zh' ? '/' : '/zh/';
const zhPosts = await publishedPosts('zh');
const posts = await publishedPosts(lang);
const s = stats(zhPosts);
const ch = await chain();

const counts = {} as Record<SectionSlug, number>;
for (const slug of sections) {
  counts[slug] = posts.filter((p) => p.collection === slug).length;
}

const drawers = sections.map((slug) => ({
  href: langPath(lang, '/' + slug),
  name: t.sections[slug].name,
  desc: t.sections[slug].desc,
  count: counts[slug],
}));
drawers.push({ href: langPath(lang, '/uses'), name: t.uses.name, desc: t.uses.desc, count: 0 });

const rows = posts.slice(0, 6).map((p) => ({
  href: langPath(lang, '/' + p.collection) + '/' + keyOf(p),
  day: utcDay(p.data.date),
  zoneName: t.sections[p.collection as SectionSlug].name,
  title: p.data.title,
  summary: p.data.summary,
}));
const newest = rows[0];

const pillsStyle = 'display: flex; gap: 0.5rem; flex-wrap: wrap';
const buttonsStyle = 'display: flex; gap: 0.625rem; flex-wrap: wrap';
const listStyle = 'padding-inline-start: 1.2rem; color: var(--text-2)';
const cardLinkStyle = '--flow-gap: 0.4rem; text-decoration: none; color: inherit';
const chainLinkStyle = 'text-decoration: none';
const verifyHref = langPath(lang, '/verify');
const aboutHref = langPath(lang, '/about');
const journalHref = langPath(lang, '/journal');
const head8 = ch.head.slice(0, 8);
const latestDay = s.latest ? utcDay(s.latest) : '—';
const roleLabel = lang === 'en' ? site.role : site.roleZh;
const startPill = lang === 'en' ? `Public record since ${site.start}` : `自 ${site.start} 起公开记录`;
const authorPill = lang === 'en' ? `by ${site.author}` : site.authorZh;
const heroSectionStyle = '--flow-gap: 1.75rem';
const headerSectionStyle = '--flow-gap: 0.85rem';
const sloganStyle =
  'font-family: var(--font-display); font-weight: var(--fw-bold); font-size: clamp(1.25rem, 1rem + 1vw, 1.6rem); letter-spacing: -0.01em; color: var(--brand-deep)';
const introStyle = 'color: var(--text-2); max-width: 46rem';
const countStyle = 'font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-2)';
const signature = lang === 'en' ? brand.signatureEn : brand.signatureZh;
---

<Base title={brand.name} path={path} lang={lang} switchHref={switchHref}>
  <SiteJsonLd lang={lang} />

  <section class="wrap flow hero-band" style={heroSectionStyle}>
    <header class="flow measure" style={headerSectionStyle}>
      <p style={pillsStyle}>
        <span class="seal" lang="en">[OK]</span>
        <span class="stamp" lang="en">{brand.abbr}</span>
        <span class="pill" lang="en">{roleLabel}</span>
        <span class="pill">{startPill}</span>
        <span class="pill">{authorPill}</span>
      </p>
      <h1 lang="en">{brand.name}</h1>
      <p style={sloganStyle}>{t.slogan}</p>
      <p style={introStyle}>{t.intro}</p>
    </header>

    <div class="card telemetry">
      <div class="stat-row">
        <span class="stat"><b>{s.elapsedDays}</b><small>{t.stats.days}</small></span>
        <span class="stat"><b>{s.entries}</b><small>{t.stats.entries}</small></span>
        <span class="stat"><b>{s.streak}</b><small>{t.stats.streak}</small></span>
        <span class="stat"><b>{latestDay}</b><small>{t.stats.latest}</small></span>
        <span class="stat">
          <b><a href={verifyHref} class="mono" style={chainLinkStyle}>{head8}</a></b>
          <small>{t.stats.chain}</small>
        </span>
        <span class="stat"><b>{metrics.gates}</b><small>{t.stats.gates}</small></span>
        <span class="stat"><b>{metrics.lastRedGate}</b><small>{t.stats.lastRed}</small></span>
      </div>
    </div>

    <p style={buttonsStyle}>
      {newest && <a class="btn" href={newest.href}>{t.buttons.latest}</a>}
      <a class="btn btn-ghost" href={verifyHref}>{t.buttons.verify}</a>
      <a class="btn btn-ghost" href={aboutHref}>{t.buttons.about}</a>
    </p>
  </section>

  <section class="wrap flow">
    <h2 lang="en">{t.manifesto.title}</h2>
    <div class="voice-card">
      {t.manifesto.raw && <input type="checkbox" id="voice-raw" class="voice-check" />}
      <div class="voice-head">
        <span class="voice-who">OJ · 2026-11-04 · {lang === 'zh' ? '现场手打' : 'typed on the spot'}</span>
        {t.manifesto.raw && (
          <span class="voice-seg">
            <label class="seg-lab seg-std" for="voice-raw">标准版</label>
            <label class="seg-lab seg-raw" for="voice-raw">原话（含笔误）</label>
          </span>
        )}
      </div>
      <p class="voice-std">{t.manifesto.std}</p>
      {t.manifesto.raw && <p class="voice-raw">{t.manifesto.raw}</p>}
      <p class="voice-note">
        {t.manifesto.note}
        {t.manifesto.origHref && <a href={langPath(lang, '/zh/')}>{lang === 'en' ? 'Original typing (Chinese, unproofed)' : '手打原文（未校对）'}</a>}
      </p>
    </div>
  </section>

  <section class="wrap flow">
    <h2>{t.self.title}</h2>
    <div class="voice-card">
      {t.self.raw && <input type="checkbox" id="voice-self" class="voice-check" />}
      <div class="voice-head">
        <span class="voice-who">OJ · 2026-11-04 · {lang === 'zh' ? '现场手打' : 'typed on the spot'}</span>
        {t.self.raw && (
          <span class="voice-seg">
            <label class="seg-lab seg-std" for="voice-self">标准版</label>
            <label class="seg-lab seg-raw" for="voice-self">原话（含笔误）</label>
          </span>
        )}
      </div>
      <p class="voice-std">{t.self.std}</p>
      {t.self.raw && <p class="voice-raw">{t.self.raw}</p>}
      <p class="voice-note">
        {t.self.note}
        {t.self.origHref && <a href={langPath(lang, '/zh/')}>{lang === 'en' ? 'Original typing (Chinese, unproofed)' : '手打原文（未校对）'}</a>}
      </p>
    </div>
  </section>

  <section class="wrap flow">
    <h2>{t.home.zones}</h2>
    <div class="grid grid-3">
      {
        drawers.map((d) => (
          <a class="card flow" href={d.href} style={cardLinkStyle}>
            <h3>{d.name}</h3>
            <p class="meta">{d.desc}</p>
            {d.count > 0 && <p style={countStyle}>{t.count(d.count)}</p>}
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap flow">
    <h2>{t.home.recent}</h2>
    {
      rows.length === 0 ? (
        <p class="meta">{t.zone.empty}</p>
      ) : (
        <ul class="post-list measure">
          {rows.map((r) => (
            <li>
              <a href={r.href}>
                <span class="meta">{r.day} · {r.zoneName}</span>
                <p class="post-title">{r.title}</p>
                {r.summary && <p class="post-excerpt">{r.summary}</p>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p><a class="btn btn-ghost" href={journalHref}>{t.buttons.journal}</a></p>
  </section>

  <section class="wrap flow">
    <h2>{t.home.rules}</h2>
    <ul class="measure" style={listStyle}>
      {t.rules.map((r) => <li>{r}</li>)}
    </ul>
    <p class="meta" style={pillsStyle}>
      <Brand variant="stamp" label={`${brand.abbr} — ${signature}`} />
      <span>{signature}</span>
      <span>·</span>
      <a href={verifyHref}>{t.post.verifyLink}</a>
    </p>
  </section>
</Base>
