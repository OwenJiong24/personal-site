---
// 单篇的结构化数据：BlogPosting（AEO/AIEO 要求：作者、发布与更新时间、语言、正文摘要、规范链接）。
import { brand, site } from '../lib/site';
import type { Post } from '../lib/trust';
import { langPath } from '../lib/i18n';
import { mdMirrorFor } from '../lib/mirror';

interface Props {
  entry: Post;
  lang: 'zh' | 'en';
  path: string;
  twinPath?: string;
  chainHash: string;
}

const { entry, lang, path, twinPath, chainHash } = Astro.props;
const base = Astro.site ?? new URL('https://orangeknows.com');
const url = (p: string) => new URL(p, base).toString();
const body = (entry as unknown as { body?: string }).body ?? '';
const words = body.split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / (lang === 'en' ? 200 : 350)));

const faq = (((entry.data as { faq?: Array<{ q: string; a: string }> }).faq) ?? []) as Array<{ q: string; a: string }>;
const mdMirror = mdMirrorFor(path);
const faqPage = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const org = {
  '@type': 'Organization',
  name: site.name,
  url: url('/'),
  logo: { '@type': 'ImageObject', url: url('/logo-512.png'), width: 512, height: 512 },
  image: url('/og.png'),
  // 出版原则写在关于页与记录机制上：这是搜索引擎与 AI 引擎判断「谁为此负责」的关键字段
  publishingPrinciples: url(langPath(lang, '/about')),
  alternateName: brand.zh,
};

const data = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.summary || entry.data.title,
  inLanguage: lang === 'en' ? 'en' : 'zh-CN',
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  timeRequired: `PT${minutes}M`,
  wordCount: words,
  image: [
    { '@type': 'ImageObject', url: url('/og.png'), width: 2400, height: 1260 },
    { '@type': 'ImageObject', url: url('/logo-512.png'), width: 512, height: 512 },
  ],
  author: {
    '@type': 'Person',
    name: site.author,
    url: url(langPath(lang, '/about')),
    ...(site.anchors.github ? { sameAs: ['https://github.com/' + site.anchors.github] } : {}),
    ...(site.anchors.email ? { email: site.anchors.email } : {}),
    worksFor: org,
  },
  // 文章富结果要求 publisher 是 Organization 且带 logo；此前写成人名，Google 拿不到发布者标识
  publisher: org,
  ...(faq.length ? { audience: { '@type': 'Audience', audienceType: (entry.data as { audience?: string }).audience ?? 'makers' } } : {}),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url(path) },
  url: url(path),
  isPartOf: { '@type': 'WebSite', url: url('/') },
  ...(twinPath
    ? {
        translationOfWork: { '@type': 'CreativeWork', url: url(twinPath) },
        workTranslation: { '@type': 'CreativeWork', url: url(twinPath), inLanguage: lang === 'en' ? 'zh-CN' : 'en' },
      }
    : {}),
  // 机器可读镜像：AI/harness 不必解析 HTML
  ...(mdMirror ? { citation: { '@type': 'CreativeWork', url: url(mdMirror), additionalType: 'text/markdown' } } : {}),
  // 本文进入记录链：链上摘要可核对内容未被事后改动
  signers: [{ '@type': 'PropertyValue', name: 'sha256-record-chain', value: chainHash }],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
{faqPage && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />}
