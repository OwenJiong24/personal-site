---
// 全站骨架（双语）：导航、语言切换、页脚统计与记录链头、主题切换、hreflang。值全走 tokens.css。
import { gitSha } from '../lib/build';
import '@fontsource-variable/dm-sans/index.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../lib/site';
import { publishedPosts, stats, chain } from '../lib/trust';
import { ui, langPath, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  path?: string;
  lang?: Lang;
  /** 同页另一语言的站内路径（有译文才传，语言切换按钮只在这时出现） */
  switchHref?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  path = '/',
  lang = 'zh',
  switchHref,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const t = ui[lang];
const base = Astro.site ?? new URL('https://jiong-bvw.pages.dev');
const canonical = new URL(path, base);
// switchHref = 对方语言的完整站内路径（zh 页传 /en/…，en 页传 /…）
const zhPath = lang === 'zh' ? path : switchHref;
const enPath = lang === 'en' ? path : switchHref;const posts = await publishedPosts('zh'); // 统计按文章键去重：一篇双语算一篇
const s = stats(posts);
const ch = await chain();
const role = lang === 'en' ? t.role : site.role;
const pageTitle =
  path === '/' || path === '/en/' ? `${site.name} — ${role}` : `${title} · ${site.name}`;
---

<!doctype html>
<html lang={t.htmlLang} data-style="a" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t.intro} />
    <link rel="canonical" href={canonical} />
    {
      /* hreflang：只在两版都存在时成对声明 */
      zhPath && enPath && (
        <>
          <link rel="alternate" hreflang="zh-Hans" href={new URL(zhPath, base)} />
          <link rel="alternate" hreflang="en" href={new URL(enPath, base)} />
          <link rel="alternate" hreflang="x-default" href={new URL(zhPath, base)} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — journal (zh)`} href={new URL('/rss.xml', base)} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? t.intro} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    {zhPath && enPath && <meta property="og:locale:alternate" content={lang === 'en' ? 'zh_CN' : 'en_US'} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (() => {
        const key = 'owen-site-theme';
        const saved = localStorage.getItem(key);
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={langPath(lang, '/')}>{site.name}<span class="dot">.</span></a>
        <nav class="nav" aria-label={lang === 'en' ? 'Main navigation' : '主导航'}>
          {
            t.nav.map((item) => {
              const href = langPath(lang, item.path);
              return (
                <a href={href} aria-current={path === href ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })
          }
          <a href="/rss.xml">RSS</a>
          {
            switchHref && (
              <a class="lang-switch" href={switchHref} hreflang={lang === 'en' ? 'zh-Hans' : 'en'} aria-label={t.switchAria}>
                {t.switchTo}
              </a>
            )
          }
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label={t.theme.aria}>
            <span class="theme-label" data-light={t.theme.light} data-dark={t.theme.dark}>{t.theme.light}</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="meta">
          {t.footer.line(site.name, site.start, s.entries, s.activeDays)}{' '}
          <a href={langPath(lang, '/verify')}>
            {t.footer.chain} {ch.head.slice(0, 8)}
          </a>
          {gitSha && <span> · {t.footer.built} <span class="mono">{gitSha}</span></span>}
        </p>
        <p class="meta" style="margin-inline-start:auto">
          {site.anchors.github && (
            <a href={`https://github.com/${site.anchors.github}`} rel="me noopener">GitHub</a>
          )}
          {site.anchors.github && site.anchors.email && <span> · </span>}
          {site.anchors.email && <a href={`mailto:${site.anchors.email}`}>{site.anchors.email}</a>}
          <span> · </span>
          <span>{t.footer.noTracker}</span>
        </p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const label = btn.querySelector('.theme-label');
        const darkText = label?.dataset.dark ?? '暗色';
        const lightText = label?.dataset.light ?? '亮色';
        const paint = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          if (label) label.textContent = dark ? darkText : lightText;
          btn.setAttribute('aria-pressed', String(dark));
        };
        paint();
        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('owen-site-theme', next);
          paint();
        });
      })();
    </script>
  </body>
</html>
