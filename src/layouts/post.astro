---
// 文章页：正文 + 时间戳 + 链上位置 + 同分区上下篇。
import Base from './base.astro';
import { chain, utcDay, type Post } from '../lib/trust';

interface Props {
  entry: Post;
  zone: 'journal' | 'insights' | 'work';
  zoneName: string;
  siblings: Post[]; // 同分区，新→旧
}

const { entry, zone, zoneName, siblings } = Astro.props;
const d = entry.data;
const ch = await chain();
const hash = ch.byId.get(entry.id) ?? '';
const idx = ch.ids.indexOf(entry.id) + 1;
const me = siblings.findIndex((p) => p.id === entry.id);
const newer = me > 0 ? siblings[me - 1] : undefined;
const older = me >= 0 && me < siblings.length - 1 ? siblings[me + 1] : undefined;
const path = `/${zone}/${entry.id}`;
const desc = d.summary || d.title;
---

<Base title={d.title} description={desc} path={path} ogType="article">
  <article class="wrap measure flow" style="--flow-gap: 1.25rem">
    <header class="flow stack-sm">
      <p class="meta">
        <a href={`/${zone}`} style="color: inherit; text-decoration: none">
          <span class="pill pill-accent">{zoneName}</span>
        </a>
      </p>
      <h1>{d.title}</h1>
      <p class="meta">
        记录于 {utcDay(d.date)}（UTC）
        {d.updated && ` · 更新于 ${utcDay(d.updated)}`}
        {hash && (
            <span>
              {' '}
              · 链上第 {idx} 条 <span class="mono" title={hash}>#{hash.slice(0, 8)}</span>
            </span>
          )}
      </p>
      {
        d.tags.length > 0 && (
          <p style="display: flex; gap: 0.375rem; flex-wrap: wrap">
            {d.tags.map((tag) => (
              <span class="pill">#{tag}</span>
            ))}
          </p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <nav class="card-flat" aria-label="同分区上下篇" style="display: flex; gap: 1rem; flex-wrap: wrap">
      {
        older && (
          <a href={`/${zone}/${older.id}`} style="margin-inline-end: auto">
            ← {older.data.title}
          </a>
        )
      }
      {newer && <a href={`/${zone}/${newer.id}`}>{newer.data.title} →</a>}
      {!older && !newer && <p class="meta">这是本分区目前唯一的一条记录。</p>}
    </nav>

    <p class="meta">
      本页由构建时生成；正文全文参与记录链哈希，发布后改一个字链头就会变，见 <a href="/verify">如何核对这份记录</a>。
    </p>
  </article>
</Base>
